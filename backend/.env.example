# Copie este arquivo para .env e preencha com os seus valores.
# O .env real nunca vai para o Git.

# Conexão com o MongoDB.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://usuario:senha@cluster.mongodb.net
DB_CONN_STRING=mongodb://localhost:27017

# Porta em que o backend sobe.
PORT=3000

# Origem exata do frontend, usada pelo CORS.
# Precisa bater com a URL do navegador, incluindo protocolo e porta.
# Em produção: https://seu-dominio.com.br
ORIGIN=http://localhost:5173

# Segredo usado para assinar os tokens JWT.
# Use um valor longo e aleatório. Trocar este valor desloga todo mundo.
# Gerar um valor aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Credenciais do TextBee, usadas para enviar o SMS de recuperação de senha.
# Ficam no painel em https://textbee.dev
TEXTBEE_API_KEY=sua-api-key-aqui
TEXTBEE_DEVICE_ID=seu-device-id-aqui
